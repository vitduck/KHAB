Bootstrap: docker
From: nvidia/cuda:12.5.1-devel-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        build-essential \
        wget \
        git \
        python3 \
        python3-pip \
        python3-dev \
        libopenmpi-dev \
        numactl \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3 /usr/bin/python

    # Install PyTorch 2.4.0
    pip install --no-cache-dir \
        torch==2.4.0 \
        torchvision \
        --index-url https://download.pytorch.org/whl/cu124

    # Install pinned dependencies from TRT-LLM 0.14.0 requirements
    pip install --no-cache-dir  \
        --extra-index-url https://pypi.nvidia.com \
        "accelerate>=0.25.0" \
        "colored" \
        "diffusers>=0.27.0" \
        "lark" \
        "numpy<2" \
        "onnx>=1.12.0" \
        "openai==1.39.0" \
        "polygraphy" \
        "psutil" \
        "pulp" \
        "pandas" \
        "h5py==3.10.0" \
        "StrEnum" \
        "sentencepiece>=0.1.99" \
        "tensorrt~=10.4.0" \
        "nvidia-modelopt[torch]~=0.17.0" \
        "transformers>=4.38.2,<=4.45.1" \
        "pydantic>=2.9.1" \
        "pillow==10.3.0" \
        "optimum" \
        "evaluate" \
        "mpmath>=1.3.0" \
        "click" \
        "click_option_group" \
        "aenum" \
        "mpi4py" \
        "cuda-python==12.5.0" \
        "pynvml==11.5.0" 

    # Install TRT-LLM
    pip install --no-cache-dir \
        --extra-index-url https://pypi.nvidia.com \
        tensorrt-llm==0.14.0

    # Clone source scripts only
    cd /opt
    git clone --branch v0.14.0 --depth 1 \
        https://github.com/NVIDIA/TensorRT-LLM.git 

    # Missing symlink 
    ln -sf /usr/local/lib/python3.10/dist-packages/tensorrt_llm/libs/libnvinfer_plugin_tensorrt_llm.so \
           /usr/local/lib/python3.10/dist-packages/tensorrt_llm/libs/libnvinfer_plugin_tensorrt_llm.so.10 

    # Annoying nvidia banner 
    rm -f /opt/nvidia/entrypoint.d/10-banner.sh
    rm -f /opt/nvidia/entrypoint.d/12-banner.sh
    rm -f /opt/nvidia/entrypoint.d/15-container-copyright.txt
    rm -f /opt/nvidia/entrypoint.d/30-container-license.txt
    rm -f /opt/nvidia/entrypoint.d/80-internal-image.sh
    rm -f /opt/nvidia/entrypoint.d/90-deprecated-image.sh

    # Cleanup
    pip cache purge

%environment
    export CUDA_HOME=/usr/local/cuda
    export TRTLLM_SCRIPTS=/opt/trtllm-scripts
    export PATH=${TRTLLM_SCRIPTS}/examples:$PATH
    export LD_LIBRARY_PATH=${CUDA_HOME}/lib64:$LD_LIBRARY_PATH
    export LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/tensorrt_libs:$LD_LIBRARY_PATH
    export LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/tensorrt_llm/libs:$LD_LIBRARY_PATH

%labels
    TensorRT-LLM  v0.14.0
    TensorRT      10.4.0
    CUDA          12.4.1
    GPU_TARGET    V100 (sm_70)
    Base          nvidia/cuda:12.4.1-devel-ubuntu22.04
